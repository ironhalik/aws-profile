# vim: set ft=bash :
# Entry point: source this file from your shell rc.

# shellcheck disable=SC2296  # ${(%):-%x} is zsh's BASH_SOURCE
_aws_lib="$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")/lib"
for _aws_f in common profile session-token ssm; do
  # shellcheck source=/dev/null
  source "${_aws_lib}/${_aws_f}.sh"
done
unset _aws_lib _aws_f
